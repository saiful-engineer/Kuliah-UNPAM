import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.Arrays;

public class LatihanArray {
    
    public static void main(String[] args) {
        BufferedReader dataIn = new BufferedReader(new InputStreamReader(System.in));
        String BacaInput;
        int JmlData = 0;
        byte DataArray[];
        
        System.out.print("Jumlah data : ");
        
        try {
            BacaInput = dataIn.readLine();
            JmlData = Integer.parseInt(BacaInput);
        } catch (IOException e) {
            System.out.println("Ada kesalahan !");
        }
        
        DataArray = new byte[JmlData];
        
        // Input data
        System.out.println("\nMembaca data dari keyboard");
        for (int i = 0; i < JmlData; i++) {
            System.out.print("DataArray[" + i + "] = ");
            try {
                BacaInput = dataIn.readLine();
                DataArray[i] = Byte.parseByte(BacaInput);
            } catch (IOException e) {
                System.out.println("Ada kesalahan !");
            }
        }
        
        // Tampilkan data
        System.out.println("\nData dalam array:");
        for (int i = 0; i < JmlData; i++) {
            System.out.println("DataArray[" + i + "] = " + DataArray[i]);
        }
        
        // Mencari nilai maksimum & minimum
        byte max = DataArray[0];
        byte min = DataArray[0];
        
        for (int i = 1; i < JmlData; i++) {
            if (DataArray[i] > max) {
                max = DataArray[i];
            }
            if (DataArray[i] < min) {
                min = DataArray[i];
            }
        }
        
        System.out.println("\nNilai Maksimum : " + max);
        System.out.println("Nilai Minimum  : " + min);
        
        // Mengurutkan array (ascending)
        Arrays.sort(DataArray);
        
        System.out.println("\nData setelah diurutkan (Ascending):");
        for (int i = 0; i < JmlData; i++) {
            System.out.println("DataArray[" + i + "] = " + DataArray[i]);
        }
    }
}
